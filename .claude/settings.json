{
  "permissions": {
    "allow": ["Bash(node scripts/tokens-lint.mjs --root tokens/core --limit 3)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/pre-edit-guard.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/post-edit-format.mjs" }]
      }
    ]
  }
}
