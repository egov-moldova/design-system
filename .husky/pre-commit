#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# -----------------------------------------------------------------------------
# Auto-unstage Stencil-generated files (informative; does NOT abort commit)
#
# Why: parallel agents and `yarn test`/`yarn build` regenerate these tracked
# files. A `git add -A` would accidentally stage them. CI is the canonical
# regeneration point — see .gitattributes (merge=ours) and
# .github/workflows/ci.yml "Validate (PR)" job.
# -----------------------------------------------------------------------------
GENERATED_PATTERNS='^(src/components\.d\.ts$|src/components/[^/]+/readme\.md$|src/hidden/[^/]+/readme\.md$|\.storybook/custom-elements\.json$|tokens/generated/)'

STAGED_GEN=$(git diff --cached --name-only | grep -E "$GENERATED_PATTERNS" || true)
if [ -n "$STAGED_GEN" ]; then
  printf "\n[i] Auto-unstaging Stencil-generated files (regenerated by CI):\n"
  echo "$STAGED_GEN" | sed 's/^/    /'
  echo "$STAGED_GEN" | xargs git restore --staged
  printf "  -> commit proceeds with remaining staged changes.\n\n"
fi

if [ -z "$(git diff --cached --name-only)" ]; then
  printf "[x] Nothing left to commit after unstaging generated files. Aborting.\n"
  exit 1
fi

printf "\n>> Husky pre-commit: running typecheck, lint, and unit tests...\n\n"
yarn typecheck && yarn lint && yarn test
