# The build, generated-files and check.verify gates CI runs, before a push reaches it.
# CI alone runs the token and colour lints, the dependency audit and the Docker build.

# Git exports the repository location to every hook. A test that builds a scratch repo would
# inherit it and commit into this repository instead; git finds this one from the cwd anyway.
# Same list as scripts/git/env.mjs, asserted by scripts/__tests__/git-hooks.spec.mjs.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX

# Build first: it regenerates the tracked generated files, and the script
# tests in check.verify read .storybook/custom-elements.json from it.
yarn build

# A merge keeps our side of generated files (`merge=ours`), so a stale copy can
# only be caught by regenerating it. Anything the build changed or added here
# was not committed with the change that produced it.
STALE=$(git status --porcelain -- 'src/components/*/readme.md' 'src/hidden/*/readme.md')
if [ -n "$STALE" ]; then
  printf '\n[x] Generated files differ from the commit being pushed:\n%s\n' "$STALE"
  printf '    Commit them (they were regenerated by yarn build) and push again.\n'
  printf '    Uncommitted source edits also change them: commit or set those aside first.\n\n'
  exit 1
fi

yarn check.verify
