{
  "name": "@age/angular-design-system",
  "version": "0.0.1",
  "description": "Angular wrapper for AGE Design System components",
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "copy:tokens": "mkdir -p src/styles && cp -r ../tokens/generated/* src/styles/",
    "prepare": "npm run build"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@age/design-system": "*",
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@age/design-system": "workspace:*",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/core": "^18.2.0",
    "ng-packagr": "^18.2.0",
    "rxjs": "^7.8.1",
    "typescript": "~5.5.4",
    "zone.js": "~0.14.10"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/age/design-system.git"
  },
  "keywords": [
    "angular",
    "web-components",
    "design-system",
    "stencil"
  ],
  "license": "MIT",
  "module": "dist/fesm2022/age-angular-design-system.mjs",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "esm2022": "./dist/esm2022/age-angular-design-system.mjs",
      "esm": "./dist/esm2022/age-angular-design-system.mjs",
      "default": "./dist/fesm2022/age-angular-design-system.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "sideEffects": false
}
