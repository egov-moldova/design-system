{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "fixture": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/fixture",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "styles": ["@egov-moldova/mud/tokens/core.tokens.css", "@egov-moldova/mud/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "negative": {
              "outputPath": "dist/negative",
              "browser": "negative/main.ts",
              "tsConfig": "tsconfig.negative.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
