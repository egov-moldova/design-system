{
  "1. Semantic Colors": {
    "background": {
      "base": {
        "default": {
          "$value": {
            "Light Mode": "{2. Primitive Colors: Do not use directly.white.1000}",
            "Dark Mode": "{2. Primitive Colors: Do not use directly.gray.900}"
          },
          "$type": "color"
        },
        "default-hover": {
          "$value": {
            "Light Mode": "{2. Primitive Colors: Do not use directly.gray.100}",
            "Dark Mode": "{2. Primitive Colors: Do not use directly.gray.800}"
          },
          "$type": "color"
        }
      },
      "alpha": {
        "overlay-dark": {
          "$value": {
            "Light Mode": "{2. Primitive Colors: Do not use directly.alpha.black.100-alpha}",
            "Dark Mode": "{2. Primitive Colors: Do not use directly.alpha.black.100-alpha}"
          },
          "$type": "color"
        }
      }
    },
    "border": {
      "base": {
        "default": {
          "$value": {
            "Light Mode": "{2. Primitive Colors: Do not use directly.gray.250}",
            "Dark Mode": "{2. Primitive Colors: Do not use directly.gray.600}"
          },
          "$type": "color"
        }
      }
    },
    "text": {
      "base": {
        "default": {
          "$value": {
            "Light Mode": "{2. Primitive Colors: Do not use directly.black.1000}",
            "Dark Mode": "{2. Primitive Colors: Do not use directly.white.1000}"
          },
          "$type": "color"
        }
      }
    },
    "icon": {
      "base": {
        "default": {
          "$value": {
            "Light Mode": "{2. Primitive Colors: Do not use directly.black.1000}",
            "Dark Mode": "{2. Primitive Colors: Do not use directly.white.1000}"
          },
          "$type": "color"
        }
      }
    },
    "hack": {
      "do-not-implement": {
        "$value": {
          "Light Mode": "#00000000",
          "Dark Mode": "#00000000"
        },
        "$type": "color"
      }
    }
  },
  "2. Primitive Colors: Do not use directly": {
    "gray": {
      "50": { "$value": "#f7f7f7", "$type": "color" },
      "100": { "$value": "#f5f5f5", "$type": "color" },
      "250": { "$value": "#d9d9d9", "$type": "color" },
      "600": { "$value": "#444444", "$type": "color" },
      "800": { "$value": "#2c2c2c", "$type": "color" },
      "900": { "$value": "#1e1e1e", "$type": "color" }
    },
    "blue-sky": {
      "100": { "$value": "#e8f0fb", "$type": "color" },
      "600": { "$value": "#0058d2", "$type": "color" }
    },
    "white": {
      "1000": { "$value": "#ffffff", "$type": "color" }
    },
    "black": {
      "1000": { "$value": "#121212", "$type": "color" }
    },
    "alpha": {
      "black": {
        "100-alpha": { "$value": "#1212120d", "$type": "color" }
      },
      "gray": {
        "alpha-100": { "$value": "#44444408", "$type": "color" }
      }
    }
  },
  "3. Sizes": {
    "spacings": {
      "spacing-0": { "$value": "", "$type": "number" },
      "spacing-12": { "$value": 12, "$type": "number" },
      "spacing-24": { "$value": 24, "$type": "number" }
    },
    "border-radius": {
      "radius-0": { "$value": "", "$type": "number" },
      "radius-8": { "$value": 8, "$type": "number" },
      "radius-full": { "$value": 999, "$type": "number" }
    },
    "border-width": {
      "border-1": { "$value": 1, "$type": "number" },
      "border-1,5": { "$value": 1.5, "$type": "number" }
    }
  },
  "4. Typography Primitives": {
    "font-size": {
      "fs-12": { "$value": 12, "$type": "number" },
      "fs-16": { "$value": 16, "$type": "number" }
    },
    "font-family": {
      "primary-font": { "$value": "Onest", "$type": "string" }
    },
    "font-weight": {
      "fw-regular": { "$value": 400, "$type": "number" },
      "fw-semibold": { "$value": 600, "$type": "number" }
    },
    "line-height": {
      "lh-16": { "$value": 16, "$type": "number" }
    }
  }
}
