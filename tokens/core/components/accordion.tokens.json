{
  "accordion": {
    "header": {
      "paddingInline": {
        "md": {
          "$value": "{spacing.12}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{spacing.8}",
          "$type": "dimension"
        }
      },
      "paddingBlock": {
        "$value": "{spacing.8}",
        "$type": "dimension"
      },
      "gap": {
        "$value": "{spacing.2}",
        "$type": "dimension"
      },
      "background": {
        "hover": {
          "$value": "{color.background.alpha.overlay-light}",
          "$type": "color"
        },
        "pressed": {
          "$value": "{color.background.alpha.overlay-light}",
          "$type": "color"
        },
        "disabled": {
          "$value": "transparent",
          "$type": "color"
        }
      },
      "borderColor": {
        "$value": "{color.border.base.subtle}",
        "$type": "color"
      },
      "borderWidth": {
        "$value": "{borderWidth.1}",
        "$type": "dimension"
      },
      "text": {
        "default": {
          "$value": "{color.text.base.secondary}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.text.base.default}",
          "$type": "color"
        },
        "pressed": {
          "$value": "{color.text.base.default}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.text.base.tertiary}",
          "$type": "color"
        }
      }
    },
    "summary": {
      "gap": {
        "$value": "{spacing.8}",
        "$type": "dimension"
      },
      "padding": {
        "$value": "{spacing.4}",
        "$type": "dimension"
      }
    },
    "icon": {
      "size": {
        "md": {
          "$value": "{spacing.20}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{spacing.16}",
          "$type": "dimension"
        }
      },
      "padding": {
        "$value": "{spacing.4}",
        "$type": "dimension"
      },
      "borderRadius": {
        "$value": "{borderRadius.4}",
        "$type": "dimension"
      }
    },
    "outline": {
      "width": {
        "focus": {
          "$value": "{borderWidth.2}",
          "$type": "dimension"
        }
      },
      "color": {
        "focus": {
          "$value": "{color.border.brand.default}",
          "$type": "color"
        }
      }
    },
    "panel": {
      "padding": {
        "$value": "{spacing.16}",
        "$type": "dimension"
      },
      "gap": {
        "$value": "{spacing.16}",
        "$type": "dimension"
      }
    },
    "font": {
      "size": {
        "md": {
          "$value": "{fontSize.14}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{fontSize.12}",
          "$type": "dimension"
        }
      },
      "lineHeight": {
        "md": {
          "$value": "{lineHeight.20}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{lineHeight.16}",
          "$type": "dimension"
        }
      },
      "weight": {
        "$value": "{fontWeight.semibold}",
        "$type": "fontWeight"
      },
      "family": {
        "$value": "{fontFamily.primary}",
        "$type": "fontFamily"
      }
    },
    "skeleton": {
      "header": {
        "paddingBlock": {
          "$value": "{spacing.4}",
          "$type": "dimension"
        }
      }
    }
  }
