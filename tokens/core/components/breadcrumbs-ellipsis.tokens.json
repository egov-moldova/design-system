{
  "breadcrumbs-ellipsis": {
    "color": {
      "default": {
        "$value": "{color.text.brand.on-secondary}",
        "$type": "color"
      },
      "hover": {
        "$value": "{color.text.brand.on-secondary}",
        "$type": "color"
      },
      "pressed": {
        "$value": "{color.text.brand.default}",
        "$type": "color"
      },
      "disabled": {
        "$value": "{color.text.base.tertiary}",
        "$type": "color"
      }
    },
    "outlineColor": {
      "focus": {
        "$value": "{color.border.brand.default}",
        "$type": "color"
      }
    },
    "outlineWidth": {
      "$value": "{borderWidth.2}",
      "$type": "dimension"
    },
    "outlineOffset": {
      "$value": "{spacing.12}",
      "$type": "dimension"
    },
    "background": {
      "focus": {
        "$value": "{color.background.base.default}",
        "$type": "color"
      }
    },
    "borderRadius": {
      "$value": "{borderRadius.4}",
      "$type": "dimension"
    },
    "dropdown": {
      "background": {
        "$value": "{color.background.base.default}",
        "$type": "color"
      },
      "borderRadius": {
        "$value": "{borderRadius.8}",
        "$type": "dimension"
      },
      "minWidth": {
        "$value": "160px",
        "$type": "dimension"
      }
    },
    "ellipsis": {
      "letterSpacing": {
        "$value": "0.1em",
        "$type": "dimension"
      }
    }
  }
}
