{
  "link": {
    "label": {
      "color": {
        "default": {
          "$value": "{color.text.brand.on-secondary}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.text.brand.on-secondary}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.text.brand.default}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.text.base.tertiary}",
          "$type": "color"
        },
        "error": {
          "$value": "{color.text.danger.default}",
          "$type": "color"
        }
      },
      "gap": {
        "md": {
          "$value": "{spacing.12}",
          "$type": "size"
        },
        "sm": {
          "$value": "{spacing.12}",
          "$type": "size"
        }
      },
      "borderRadius": {
        "md": {
          "$value": "{borderRadius.24}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{borderRadius.24}",
          "$type": "dimension"
        }
      },
      "outlineColor": {
        "focus": {
          "$value": "{color.border.brand.default}",
          "$type": "color"
        }
      },
      "outlineWidth": {
        "focus": {
          "$value": "{borderWidth.2}",
          "$type": "dimension"
        }
      },
      "outlineOffset": {
        "focus": {
          "$value": "{borderWidth.2}",
          "$type": "dimension"
        }
      },
      "underline": {
        "color": {
          "$value": "currentColor",
          "$type": "color"
        },
        "offset": {
          "$value": "{spacing.8}",
          "$type": "dimension"
        }
      }
    },
    "icon": {
      "size": {
        "md": {
          "$value": "{spacing.20}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{spacing.16}",
          "$type": "dimension"
        }
      }
    },
    "skeleton": {
      "backgroundColor": {
        "default": {
          "$value": "{color.background.disabled.default}",
          "$type": "color"
        }
      },
      "width": {
        "md": {
          "$value": "91px",
          "$type": "dimension"
        },
        "sm": {
          "$value": "72px",
          "$type": "dimension"
        }
      },
      "height": {
        "md": {
          "$value": "{spacing.20}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{spacing.16}",
          "$type": "dimension"
        }
      }
    }
