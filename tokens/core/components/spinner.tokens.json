{
  "spinner": {
    "size": {
      "xs": {
        "$value": "{spacing.16}",
        "$type": "dimension"
      },
      "sm": {
        "$value": "{spacing.20}",
        "$type": "dimension"
      },
      "md": {
        "$value": "{spacing.32}",
        "$type": "dimension"
      },
      "lg": {
        "$value": "{spacing.40}",
        "$type": "dimension"
      }
    },
    "stroke": {
      "width": {
        "xs": {
          "$value": "{spacing.2}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "2.5px",
          "$type": "dimension",
          "$comment": "Off the spacing scale: Figma draws the Small ring 2.5px thick (44:438)."
        },
        "md": {
          "$value": "3px",
          "$type": "dimension"
        },
        "lg": {
          "$value": "3.75px",
          "$type": "dimension",
          "$comment": "Off the spacing scale: Figma draws the Large ring 3.75px thick (44:466)."
        }
      }
    },
    "arc": {
      "color": {
        "brand": {
          "$value": "{color.background.brand.default}",
          "$type": "color"
        },
        "dark": {
          "$value": "{color.icon.base.default}",
          "$type": "color",
          "$comment": "Figma Dark spinner is #121212 (44:442, 44:470, 44:474); the Extra Small one is #383838 (44:426), which looks like a slip in the design."
        },
        "light": {
          "$value": "{color.text.base-inverse.default}",
          "$type": "color"
        },
        "lightOnColor": {
          "$value": "{color.text.base-inverse.on-color}",
          "$type": "color"
        }
      }
    },
    "transitionDuration": {
      "$value": "800ms",
      "$type": "duration"
    },
    "transitionTimingFunction": {
      "$value": "linear",
      "$type": "cubicBezier"
    }
  }
}
