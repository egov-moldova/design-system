{
  "usesDtcg": true,
  "source": ["tokens/core/**/*.tokens.json"],
  "platforms": {
    "css": {
      "transforms": ["attribute/cti", "name/kebab", "color/hex"],
      "buildPath": "dist/mud/tokens/",
      "files": [
        {
          "destination": "core.tokens.css",
          "format": "css/variables",
          "options": {
            "showFileHeader": false
          }
        }
      ]
    },
    "storybook": {
      "transforms": ["attribute/cti", "name/pascal", "color/hex"],
      "buildPath": ".storybook/stories/assets/",
      "files": [
        {
          "destination": "core.tokens.json",
          "format": "json/nested"
        }
      ]
    },
    "tailwind": {
      "transforms": ["attribute/cti", "name/pascal", "color/hex"],
      "buildPath": "tokens/generated/",
      "files": [
        {
          "destination": "core.tokens.json",
          "format": "json/nested"
        }
      ]
    }
  }
}
