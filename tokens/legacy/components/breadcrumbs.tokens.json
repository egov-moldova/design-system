{
  "breadcrumbs": {
    "separator": {
      "color": {
        "$value": "{color.text.base.tertiary}",
        "$type": "color"
      }
    },
    "gap": {
      "$value": "{spacing.12}",
      "$type": "dimension"
    },
    "item": {
      "borderRadius": {
        "$value": "{borderRadius.4}",
        "$type": "dimension"
      }
    },
    "current-page": {
      "color": {
        "default": {
          "$value": "{color.text.base.secondary}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.text.base.tertiary}",
          "$type": "color"
        }
      },
      "fontSize": {
        "$value": "{fontSize.14}",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": "{lineHeight.20}",
        "$type": "dimension"
      },
      "fontWeight": {
        "$value": "{fontWeight.regular}",
        "$type": "fontWeight"
      }
    }
  }
}
