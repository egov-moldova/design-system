{
  "column-action": {
    "size": {
      "$value": "20px",
      "$type": "dimension"
    },
    "padding": {
      "$value": "{spacing.2}",
      "$type": "dimension"
    },
    "borderRadius": {
      "$value": "{borderRadius.4}",
      "$type": "dimension"
    },
    "default": {
      "background": {
        "$value": "transparent",
        "$type": "color"
      },
      "icon": {
        "color": {
          "$value": "{color.icon.base.tertiary}",
          "$type": "color"
        }
      }
    },
    "hover": {
      "background": {
        "$value": "transparent",
        "$type": "color"
      },
      "icon": {
        "color": {
          "$value": "{color.icon.brand.on-secondary}",
          "$type": "color"
        }
      }
    },
    "active": {
      "background": {
        "$value": "transparent",
        "$type": "color"
      },
      "icon": {
        "color": {
          "$value": "{color.icon.brand.on-secondary}",
          "$type": "color"
        }
      }
    },
    "focus": {
      "background": {
        "$value": "{color.background.base.default}",
        "$type": "color"
      },
      "borderColor": {
        "$value": "{color.border.brand.default}",
        "$type": "color"
      },
      "borderWidth": {
        "$value": "{borderWidth.2}",
        "$type": "dimension"
      },
      "icon": {
        "color": {
          "$value": "{color.icon.base.secondary}",
          "$type": "color"
        }
      }
    },
    "disabled": {
      "background": {
        "$value": "transparent",
        "$type": "color"
      },
      "icon": {
        "color": {
          "$value": "{color.icon.base.tertiary}",
          "$type": "color"
        }
      }
    }
  }
}
