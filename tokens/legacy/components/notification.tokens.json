          "$value": "{color.icon.base.secondary}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.icon.base.default}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.icon.base.default}",
          "$type": "color"
        },
        "focus": {
          "$value": "{color.icon.base.default}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.icon.base.tertiary}",
          "$type": "color"
        }
      },
      "background": {
