{
  "toggle": {
    "track": {
      "width": {
        "md": {
          "$value": "28px",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{spacing.24}",
          "$type": "dimension"
        }
      },
      "height": {
        "md": {
          "$value": "{spacing.16}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "14px",
          "$type": "dimension"
        }
      },
      "borderRadius": {
        "md": {
          "$value": "10px",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{borderRadius.8}",
          "$type": "dimension"
        }
      },
      "background": {
        "default": {
          "$value": "{color.background.base.default-active}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.background.base.default-hover}",
          "$type": "color"
        },
        "pressed": {
          "$value": "{color.background.base.default-active}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.background.alpha.overlay-light}",
          "$type": "color"
        }
      },
      "checked": {
        "background": {
          "default": {
            "$value": "{color.background.brand.default-hover}",
            "$type": "color"
          },
          "hover": {
            "$value": "{color.icon.brand.on-secondary}",
            "$type": "color"
          },
          "pressed": {
            "$value": "{color.border.brand.default}",
            "$type": "color"
          },
          "disabled": {
            "$value": "{color.background.base.default-hover}",
            "$type": "color"
          }
        }
      },
      "invalid": {
        "background": {
          "$value": "{color.background.base.default}",
          "$type": "color"
        },
        "borderColor": {
          "$value": "{color.icon.danger.default}",
          "$type": "color"
        },
        "hover": {
          "background": {
            "$value": "{color.background.base.default}",
            "$type": "color"
          },
          "borderColor": {
            "$value": "{color.border.brand.default}",
            "$type": "color"
          }
        }
      }
    },
    "thumb": {
      "size": {
        "md": {
          "$value": "14px",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{spacing.12}",
          "$type": "dimension"
        }
      },
      "position": {
        "md": {
          "$value": "{spacing.2}",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{spacing.2}",
          "$type": "dimension"
        }
      },
      "position-checked": {
        "md": {
          "$value": "14px",
          "$type": "dimension"
        },
        "sm": {
          "$value": "{spacing.12}",
          "$type": "dimension"
        }
      },
      "background": {
        "default": {
          "$value": "{color.background.base.default}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.text.base.tertiary}",
          "$type": "color"
        }
      },
      "invalid": {
        "background": {
          "$value": "{controls.selected.invalid.background}",
          "$type": "color"
        }
      }
    }
  }
}
