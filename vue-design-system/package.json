{
  "name": "@age/vue-design-system",
  "version": "0.0.1",
  "description": "Vue wrapper for AGE Design System components",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node scripts/fix-generated.js",
    "build": "tsc",
    "postbuild": "cp -r src/components dist/",
    "copy:tokens": "mkdir -p src/styles && cp -r ../tokens/generated/* src/styles/",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@age/design-system": "portal:.."
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.13"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/age/design-system.git"
  },
  "keywords": [
    "vue",
    "web-components",
    "design-system",
    "stencil"
  ],
  "license": "MIT"
}
